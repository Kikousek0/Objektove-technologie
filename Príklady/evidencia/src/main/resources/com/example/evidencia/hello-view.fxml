<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="450.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.evidencia.HelloController">
    <top>
        <HBox prefHeight="130.0" prefWidth="600.0" BorderPane.alignment="CENTER">
            <children>
                <VBox prefHeight="100.0" prefWidth="79.0">
                    <children>
                        <Button mnemonicParsing="false" onAction="#add" text="Add">
                            <VBox.margin>
                                <Insets left="10.0" top="5.0" />
                            </VBox.margin>
                        </Button>
                        <Button mnemonicParsing="false" onAction="#edit" text="Edit">
                            <VBox.margin>
                                <Insets left="10.0" top="5.0" />
                            </VBox.margin>
                        </Button>
                        <Button mnemonicParsing="false" onAction="#del" text="Delete">
                            <VBox.margin>
                                <Insets left="10.0" top="5.0" />
                            </VBox.margin>
                        </Button>
                        <Button mnemonicParsing="false" onAction="#clear" text="Clear">
                            <VBox.margin>
                                <Insets left="10.0" top="5.0" />
                            </VBox.margin>
                        </Button>
                    </children>
                </VBox>
                <VBox prefHeight="100.0" prefWidth="239.0">
                    <children>
                        <TextField fx:id="nazov" promptText="Názov">
                            <VBox.margin>
                                <Insets right="10.0" top="5.0" />
                            </VBox.margin>
                        </TextField>
                        <TextField fx:id="typ" promptText="Typ">
                            <VBox.margin>
                                <Insets right="10.0" top="10.0" />
                            </VBox.margin>
                        </TextField>
                        <TextField fx:id="seriove_cislo" promptText="Sériové číslo">
                            <VBox.margin>
                                <Insets right="10.0" top="10.0" />
                            </VBox.margin>
                        </TextField>
                    </children>
                </VBox>
                <VBox prefHeight="100.0" prefWidth="259.0">
                    <children>
                        <TextField fx:id="cena" promptText="Kúpna cena">
                            <VBox.margin>
                                <Insets left="10.0" top="5.0" />
                            </VBox.margin>
                        </TextField>
                        <TextField fx:id="koniec_zaruky" promptText="Koniec záruky (napr. 2026-12-31)">
                            <VBox.margin>
                                <Insets left="10.0" top="10.0" />
                            </VBox.margin>
                        </TextField>
                        <!-- Checkbox pre prepínanie zobrazenia -->
                        <CheckBox fx:id="chkZaruka" mnemonicParsing="false" text="Zobraziť koniec záruky">
                            <VBox.margin>
                                <Insets left="10.0" top="15.0" />
                            </VBox.margin>
                        </CheckBox>
                    </children>
                </VBox>
            </children>
        </HBox>
    </top>
    <center>
        <VBox prefHeight="200.0" prefWidth="100.0" BorderPane.alignment="CENTER">
            <children>
                <Label text="Zoznam zariadení:">
                    <VBox.margin>
                        <Insets left="10.0" top="5.0" />
                    </VBox.margin>
                </Label>
                <ListView fx:id="view" prefHeight="274.0" prefWidth="580.0">
                    <VBox.margin>
                        <Insets bottom="10.0" left="10.0" right="10.0" top="5.0" />
                    </VBox.margin>
                </ListView>
            </children>
        </VBox>
    </center>
</BorderPane>
